# 本地开发环境配置模板。复制为 .env 后使用，禁止提交真实密码。
# 以下密码仅供本机开发；部署到共享或生产环境前必须全部更换。
POSTGRES_DB=supernova
POSTGRES_USER=supernova
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only

# 对象存储管理员账号，仅供本地开发使用。
MINIO_ROOT_USER=supernova
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=supernova

# SuperNova 服务配置。
SUPERNOVA_ENVIRONMENT=development
SUPERNOVA_LOG_LEVEL=INFO
SUPERNOVA_DATABASE_URL=postgresql://supernova:change-me-local-only@localhost:5432/supernova
SUPERNOVA_REDIS_URL=redis://:change-me-local-only@localhost:6379/0
