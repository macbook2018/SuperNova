# Copy to .env for local development. Never commit real credentials.
# These defaults are for local development only; replace them in shared environments.
POSTGRES_DB=supernova
POSTGRES_USER=supernova
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only

MINIO_ROOT_USER=supernova
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=supernova

SUPERNOVA_ENVIRONMENT=development
SUPERNOVA_LOG_LEVEL=INFO
SUPERNOVA_DATABASE_URL=postgresql://supernova:change-me-local-only@localhost:5432/supernova
SUPERNOVA_REDIS_URL=redis://:change-me-local-only@localhost:6379/0
SUPERNOVA_JWT_SECRET=local-development-only-secret-change-before-deploy-2026
# Local development only. Generate a unique key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUPERNOVA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VITE_API_BASE_URL=http://localhost:8001
SUPERNOVA_ACCESS_TOKEN_TTL_MINUTES=15
SUPERNOVA_REFRESH_TOKEN_TTL_DAYS=30
SUPERNOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated allowlist for platform-level model and billing administration.
SUPERNOVA_PLATFORM_ADMIN_EMAILS=admin@example.com
# JSON map of credential_ref to provider API key. Never commit real values.
SUPERNOVA_PLATFORM_CREDENTIALS_JSON={}

# Chat export import limits and worker settings
SUPERNOVA_CHAT_IMPORT_MAX_FILE_BYTES=52428800
SUPERNOVA_CHAT_IMPORT_MAX_FILES=20
SUPERNOVA_CHAT_IMPORT_WORKER_POLL_SECONDS=2
SUPERNOVA_CHAT_IMPORT_WORKER_LEASE_SECONDS=180
SUPERNOVA_CHAT_IMPORT_BATCH_SIZE=500
